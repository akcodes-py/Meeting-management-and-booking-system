# =============================================================================
# Django Secret Key & Debug Mode
# =============================================================================
SECRET_KEY=change-me-to-a-long-random-string-in-production
DEBUG=False

# Comma-separated list of allowed hostnames/domains
ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app,your-backend-domain.railway.app

# =============================================================================
# Database Configuration (MySQL)
# Provide either DATABASE_URL or individual DB_* variables.
# =============================================================================
# Option A: Full Connection URL (preferred on Railway / cloud hosts)
# DATABASE_URL=mysql://root:password@containers-us-west-1.railway.app:3306/railway

# Option B: Individual Connection Parameters
DB_NAME=meeting_booking_db
DB_USER=root
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=3306

# =============================================================================
# CORS & CSRF Configuration
# In production, set CORS_ALLOW_ALL_ORIGINS=False and specify your Vercel URL
# =============================================================================
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# =============================================================================
# Google Calendar OAuth — create credentials at:
# https://console.cloud.google.com/apis/credentials
# =============================================================================
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
# The callback URL registered in Google Cloud Console
GOOGLE_OAUTH_REDIRECT_URI=https://your-backend-domain.railway.app/api/v1/calendar/callback/
GOOGLE_OAUTH_AUTH_URI=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_OAUTH_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_CALENDAR_API_BASE=https://www.googleapis.com/calendar/v3
GOOGLE_OAUTH_SCOPE=https://www.googleapis.com/auth/calendar
GOOGLE_OAUTH_STATE_TTL_SECONDS=600
GOOGLE_OAUTH_PROVIDER=google
GOOGLE_TOKEN_REFRESH_MARGIN_SECONDS=300

# Frontend origin where the OAuth callback should redirect the user in browser
FRONTEND_URL=https://your-frontend.vercel.app

# =============================================================================
# Email Configuration (SMTP for Production, Console for Dev)
# =============================================================================
# For development:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# For production (SMTP):
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
CONTACT_EMAIL=support@yourdomain.com

# =============================================================================
# Availability & Booking Settings
# =============================================================================
AVAILABILITY_SLOT_STEP_MINUTES=15
PUBLIC_AVAILABILITY_DAYS=30
BOOKING_REMINDER_WINDOW_HOURS=24

# =============================================================================
# Rate Limiting for Public Endpoints
# =============================================================================
PUBLIC_RATE=60/min
PUBLIC_BOOKING_RATE=20/min