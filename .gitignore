# =============================================================================
.env
.env.*
.env.local
.env.*.local
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
frontend/.env.local
frontend/.env.*.local
!.env.example
!backend/.env.example
!frontend/.env.example

